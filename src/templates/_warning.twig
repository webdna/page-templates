{# Shown once, on a page that is not a complete reproduction of its template (BR-10).

   Deliberately not a transient toast: an editor who misses it would go on to publish a page
   believing it matches the template. It names what was lost, because "something was dropped" is
   not actionable. #}
<div class="pane has-sidebar-fields" data-page-templates-warning>
    <div class="warning with-icon">
        <p>
            {{ "This page was started from “{name}”, but it is not a complete copy of it."|t('page-templates', { name: warning.templateName }) }}
        </p>

        {% if warning.droppedBlockTypes|length %}
            <p>{{ "These block types no longer exist in this page’s layout, so they were left out:"|t('page-templates') }}</p>
            <ul>
                {% for blockType in warning.droppedBlockTypes %}
                    <li data-block-type="{{ blockType }}"><code>{{ blockType }}</code></li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if warning.emptiedFields|length %}
            <p>{{ "These fields held content in the template but could not be reproduced, so they are empty:"|t('page-templates') }}</p>
            <ul>
                {% for handle in warning.emptiedFields %}
                    <li data-field-handle="{{ handle }}"><code>{{ handle }}</code></li>
                {% endfor %}
            </ul>
        {% endif %}

        <p class="light">
            {{ "Nothing is wrong with the page — fill in what you need before saving."|t('page-templates') }}
        </p>
    </div>
</div>
