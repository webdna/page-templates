{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set title = template.name %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: "Page Templates"|t('page-templates'), url: url('page-templates') }
] %}

{% block content %}
    {{ actionInput('page-templates/templates/save') }}
    {{ redirectInput('page-templates') }}
    {{ hiddenInput('templateId', template.id) }}

    {{ forms.textField({
        first: true,
        label: "Name"|t('page-templates'),
        instructions: "What editors will see in the new-page button."|t('page-templates'),
        id: 'name',
        name: 'name',
        value: template.name,
        errors: template.getErrors('name'),
        required: true,
        autofocus: true,
    }) }}

    {{ forms.textareaField({
        label: "Description"|t('page-templates'),
        instructions: "Only shown here, to help tell similar templates apart."|t('page-templates'),
        id: 'description',
        name: 'description',
        value: template.description,
        errors: template.getErrors('description'),
        rows: 2,
    }) }}

    {% if availableSections|length %}
        {{ forms.checkboxGroupField({
            label: "Allowed areas"|t('page-templates'),
            instructions: "Where this template may be used. A new template starts out allowed only in the area its original page belonged to."|t('page-templates'),
            name: 'allowedSectionUids',
            options: availableSections|map(section => {
                label: section.name,
                value: section.uid,
            }),
            values: template.allowedSectionUids,
        }) }}

        {% set staleCount = template.allowedSectionUids|length - template.allowedSections|length %}
        {% if staleCount > 0 %}
            {# Reported rather than silently tidied: an area can stop resolving because a section
               was removed, and a curator should see that happened instead of finding a tick gone. #}
            <p class="warning" data-page-templates-stale>
                {{ "{count} allowed area(s) no longer exist and are ignored. Saving this template will drop them."|t('page-templates', { count: staleCount }) }}
            </p>
        {% endif %}
    {% else %}
        <p class="warning">
            {{ "This template makes a kind of page that no longer exists, so there is nowhere it can be used. It can only be deleted."|t('page-templates') }}
        </p>
    {% endif %}

    <hr>

    {# The content a template holds cannot be edited here: it is Craft's serialized field data,
       and the only thing that can meaningfully edit that is Craft's own element editor. So this
       hands the curator a scratch page made from the template, and captures it back. #}
    <div class="field" data-page-templates-content>
        <div class="heading">
            <label>{{ "Content"|t('page-templates') }}</label>
        </div>
        <div class="instructions">
            {% if template.isContentEditable %}
                <p>{{ "Editing opens a temporary page made from this template. Change it as you would any page, then save it back. Pages already made from this template are not affected."|t('page-templates') }}</p>
            {% elseif not template.includeContent %}
                <p>{{ "This template carries layout only, so there is no content to edit. To give it content, save a new template from a page."|t('page-templates') }}</p>
            {% else %}
                <p>{{ "This template cannot produce a page, so its content cannot be edited."|t('page-templates') }}</p>
            {% endif %}
        </div>
        <div class="input">
            {% if template.isContentEditable %}
                <button type="button" class="btn" id="page-templates-edit-content">
                    {{ "Edit content"|t('page-templates') }}
                </button>
            {% endif %}
            {# BR-33 is built but deliberately not offered yet. Saving a template's content
               still keeps the version it replaced, and page-templates/templates/revert-content
               still restores it — only the control is hidden, on the view that one step of undo
               raises more questions than it answers until there is a fuller version history to
               put it in. To bring it back, restore the button here and its wiring below:

                 {% if template.hasPreviousSnapshot %}
                     <button type="button" class="btn" id="page-templates-revert-content">
                         {{ "Rollback to previous version"|t('page-templates') }}
                     </button>
                 {% endif %}
            #}
        </div>
    </div>

    <hr>

    {# Read-only facts about the capture. The kind of page and whether it carries content are
       fixed at capture (BR-2) — changing either means saving a new template from a page. #}
    <div class="meta read-only">
        {{ forms.field({ label: "Kind of page"|t('page-templates') }, template.entryType ? template.entryType.name : "(deleted)"|t('page-templates')) }}
        {{ forms.field({ label: "Carries"|t('page-templates') }, template.includeContent
            ? "Content and layout"|t('page-templates')
            : "Layout only"|t('page-templates')) }}
        {{ forms.field({ label: "Snapshot format"|t('page-templates') }, template.snapshotVersion) }}
    </div>
{% endblock %}

{% js %}
    (() => {
        // Posted rather than linked: these change things, and the screen is already a full-page
        // form, so a nested form is not available to put them in.
        const post = (button, action, body, confirmText) => {
            if (!button) {
                return;
            }

            button.addEventListener('click', () => {
                if (confirmText && !window.confirm(confirmText)) {
                    return;
                }

                button.classList.add('loading');

                Craft.sendActionRequest('POST', action, {data: body})
                    .then(({data}) => {
                        window.location.href = data.cpEditUrl || data.redirect;
                    })
                    .catch((error) => {
                        button.classList.remove('loading');
                        Craft.cp.displayError(
                            error?.response?.data?.message ||
                            Craft.t('page-templates', 'Something went wrong.')
                        );
                    });
            });
        };

        post(
            document.getElementById('page-templates-edit-content'),
            'page-templates/templates/edit-content',
            {templateId: {{ template.id }}}
        );

        // The rollback control is hidden for now — see the note beside the buttons above. Its
        // wiring would go here:
        //
        //   post(
        //       document.getElementById('page-templates-revert-content'),
        //       'page-templates/templates/revert-content',
        //       {templateId: <template id>},
        //       Craft.t('page-templates', 'Roll this template back to its previous version? The content it holds now will be lost.')
        //   );
    })();
{% endjs %}
